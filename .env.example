# Mobile app — backend base URL (no trailing slash)
# Must include /api/v1. Paths in src/lib/apiClient.ts are relative (e.g. /categories).
EXPO_PUBLIC_API_URL=https://api.civicleder.in/api/v1

# Local API only when developing against a machine on your network:
# EXPO_PUBLIC_API_URL=http://192.168.x.x:3000/api/v1

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Counter for MD-###### case IDs (replaces Postgres sequence my_delhi_case_seq)
model CaseIdCounter {
  id    Int @id @default(1)
  value BigInt @default(0)

  @@map("case_id_counter")
}

model IssueCategory {
  id               String   @id @default(uuid()) @db.Char(36)
  slug             String   @unique @db.VarChar(64)
  name             String   @db.VarChar(128)
  shortDescription String?  @map("short_description") @db.Text
  active           Boolean  @default(true)
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")

  issueTypes     IssueType[]
  emergencyRules EmergencyRule[]
  routingRules   RoutingRule[]

  @@map("issue_categories")
}

model IssueType {
  id                 String   @id @default(uuid()) @db.Char(36)
  categoryId         String   @map("category_id") @db.Char(36)
  slug               String   @unique @db.VarChar(128)
  name               String   @db.VarChar(255)
  shortDescription   String?  @map("short_description") @db.Text
  active             Boolean  @default(true)
  sortOrder          Int      @default(0) @map("sort_order")
  emergencyRelevant  Boolean? @map("emergency_relevant")
  createdAt          DateTime @default(now()) @map("created_at")

  category       IssueCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  emergencyRules EmergencyRule[]
  routingRules   RoutingRule[]

  @@index([categoryId])
  @@map("issue_types")
}

model EmergencyContact {
  id             String    @id @default(uuid()) @db.Char(36)
  region         String    @default("delhi") @db.VarChar(64)
  number         String    @db.VarChar(32)
  label          String    @db.VarChar(128)
  description    String?   @db.Text
  sortOrder      Int       @default(0) @map("sort_order")
  sourceName     String?   @map("source_name") @db.VarChar(255)
  sourceUrl      String?   @map("source_url") @db.VarChar(512)
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Date
  active         Boolean   @default(true)

  @@unique([region, number])
  @@map("emergency_contacts")
}

model EmergencyRule {
  id             String    @id @default(uuid()) @db.Char(36)
  categoryId     String?   @map("category_id") @db.Char(36)
  issueTypeId    String?   @map("issue_type_id") @db.Char(36)
  ruleKind       String    @map("rule_kind") @db.VarChar(64)
  questionKey    String    @map("question_key") @db.VarChar(128)
  questionText   String    @map("question_text") @db.Text
  condition      String?   @db.Text
  emergencyLevel String    @default("high") @map("emergency_level") @db.VarChar(16)
  explanation    String?   @db.Text
  sortOrder      Int       @default(0) @map("sort_order")
  sourceName     String?   @map("source_name") @db.VarChar(255)
  sourceUrl      String?   @map("source_url") @db.VarChar(512)
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Date
  active         Boolean   @default(true)

  category  IssueCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  issueType IssueType?     @relation(fields: [issueTypeId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([ruleKind])
  @@map("emergency_rules")
}

model Authority {
  id              String    @id @default(uuid()) @db.Char(36)
  slug            String    @unique @db.VarChar(128)
  name            String    @db.VarChar(255)
  department      String?   @db.VarChar(255)
  government      String?   @db.VarChar(255)
  officialWebsite String?   @map("official_website") @db.VarChar(512)
  emergencyNumber String?   @map("emergency_number") @db.VarChar(32)
  sourceName      String?   @map("source_name") @db.VarChar(255)
  sourceUrl       String?   @map("source_url") @db.VarChar(512)
  lastVerifiedAt  DateTime? @map("last_verified_at") @db.Date
  active          Boolean   @default(true)

  channels AuthorityChannel[]
  routing  RoutingRule[]
  services AuthorityService[]

  @@map("authorities")
}

model AuthorityChannel {
  id             String    @id @default(uuid()) @db.Char(36)
  authorityId    String    @map("authority_id") @db.Char(36)
  channelType    String    @map("channel_type") @db.VarChar(32)
  label          String?   @db.VarChar(255)
  value          String?   @db.Text
  sourceName     String?   @map("source_name") @db.VarChar(255)
  sourceUrl      String?   @map("source_url") @db.VarChar(512)
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Date
  active         Boolean   @default(true)

  authority Authority @relation(fields: [authorityId], references: [id], onDelete: Cascade)

  @@index([authorityId])
  @@map("authority_channels")
}

model RoutingRule {
  id             String    @id @default(uuid()) @db.Char(36)
  categoryId     String?   @map("category_id") @db.Char(36)
  issueTypeId    String?   @map("issue_type_id") @db.Char(36)
  authorityId    String    @map("authority_id") @db.Char(36)
  confidence     String    @default("likely") @db.VarChar(32)
  notes          String?   @db.Text
  sourceName     String?   @map("source_name") @db.VarChar(255)
  sourceUrl      String?   @map("source_url") @db.VarChar(512)
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Date
  active         Boolean   @default(true)

  category  IssueCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  issueType IssueType?     @relation(fields: [issueTypeId], references: [id], onDelete: Cascade)
  authority Authority      @relation(fields: [authorityId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([issueTypeId])
  @@map("routing_rules")
}

model AuthorityService {
  id             String    @id @default(uuid()) @db.Char(36)
  authorityId    String    @map("authority_id") @db.Char(36)
  serviceKey     String    @map("service_key") @db.VarChar(128)
  title          String    @db.VarChar(255)
  description    String?   @db.Text
  channelType    String?   @map("channel_type") @db.VarChar(64)
  channelValue   String?   @map("channel_value") @db.Text
  actionUrl      String?   @map("action_url") @db.VarChar(512)
  trackingUrl    String?   @map("tracking_url") @db.VarChar(512)
  instructions   String?   @db.Text
  sortOrder      Int       @default(0) @map("sort_order")
  active         Boolean   @default(true)
  sourceName     String?   @map("source_name") @db.VarChar(255)
  sourceUrl      String?   @map("source_url") @db.VarChar(512)
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Date

  authority Authority               @relation(fields: [authorityId], references: [id], onDelete: Cascade)
  fields    AuthorityServiceField[]

  @@index([authorityId])
  @@unique([authorityId, serviceKey])
  @@map("authority_services")
}

model AuthorityServiceField {
  id          String  @id @default(uuid()) @db.Char(36)
  serviceId   String  @map("service_id") @db.Char(36)
  fieldKey    String  @map("field_key") @db.VarChar(128)
  label       String  @db.VarChar(255)
  fieldType   String  @default("text") @map("field_type") @db.VarChar(64)
  required    Boolean @default(false)
  helpText    String? @map("help_text") @db.Text
  sortOrder   Int     @default(0) @map("sort_order")
  placeholder String? @db.VarChar(255)

  service AuthorityService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("authority_service_fields")
}

model OfficialService {
  id          String   @id @default(uuid()) @db.Char(36)
  slug        String   @unique @db.VarChar(128)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  url         String?  @db.VarChar(512)
  phone       String?  @db.VarChar(64)
  categorySlug String? @map("category_slug") @db.VarChar(64)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("official_services")
}

model CitizenRight {
  id           String   @id @default(uuid()) @db.Char(36)
  slug         String   @unique @db.VarChar(128)
  title        String   @db.VarChar(255)
  body         String?  @db.Text
  categorySlug String?  @map("category_slug") @db.VarChar(64)
  sourceUrl    String?  @map("source_url") @db.VarChar(512)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("citizen_rights")
}

model Report {
  id                     String   @id @default(uuid()) @db.Char(36)
  caseId                 String   @unique @map("case_id") @db.VarChar(32)
  categorySlug           String?  @map("category_slug") @db.VarChar(64)
  issueTypeSlug          String?  @map("issue_type_slug") @db.VarChar(128)
  emergencyResult        String?  @map("emergency_result") @db.VarChar(64)
  userStatus             String   @default("draft") @map("user_status") @db.VarChar(64)
  selectedAuthoritySlug  String?  @map("selected_authority_slug") @db.VarChar(128)
  statusSourceType       String?  @default("user") @map("status_source_type") @db.VarChar(32)
  notes                  String?  @db.Text
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  locations  ReportLocation[]
  evidence   ReportEvidence[]
  complaints OfficialComplaint[]
  updates    CaseUpdate[]

  @@index([createdAt])
  @@map("reports")
}

model ReportLocation {
  id                  String   @id @default(uuid()) @db.Char(36)
  reportId            String?  @map("report_id") @db.Char(36)
  draftKey            String?  @map("draft_key") @db.VarChar(128)
  latitude            Float?
  longitude           Float?
  addressText         String?  @map("address_text") @db.Text
  landmark            String?  @db.Text
  accuracyMeters      Float?   @map("accuracy_meters")
  jurisdictionStatus  String   @default("unknown") @map("jurisdiction_status") @db.VarChar(64)
  jurisdictionId      String?  @map("jurisdiction_id") @db.Char(36)
  addLocationOnPhoto  Boolean  @default(true) @map("add_location_on_photo")
  source              String   @default("user") @db.VarChar(64)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  report Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@map("report_locations")
}

model ReportEvidence {
  id               String   @id @default(uuid()) @db.Char(36)
  reportId         String?  @map("report_id") @db.Char(36)
  draftKey         String?  @map("draft_key") @db.VarChar(128)
  mediaType        String?  @map("media_type") @db.VarChar(32)
  storagePath      String?  @map("storage_path") @db.VarChar(512)
  localUri         String?  @map("local_uri") @db.Text
  mimeType         String?  @map("mime_type") @db.VarChar(128)
  fileSizeBytes    BigInt?  @map("file_size_bytes")
  durationSeconds  Float?   @map("duration_seconds")
  width            Int?
  height           Int?
  locationOnMedia  Boolean  @default(false) @map("location_on_media")
  latitude         Float?
  longitude        Float?
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")

  report Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([draftKey])
  @@map("report_evidence")
}

model OfficialComplaint {
  id                    String    @id @default(uuid()) @db.Char(36)
  reportId              String?   @map("report_id") @db.Char(36)
  authorityId           String?   @map("authority_id") @db.Char(36)
  authoritySlug         String?   @map("authority_slug") @db.VarChar(128)
  serviceId             String?   @map("service_id") @db.Char(36)
  channelType           String?   @map("channel_type") @db.VarChar(64)
  channelValue          String?   @map("channel_value") @db.Text
  officialReference     String?   @map("official_reference") @db.VarChar(255)
  hasOfficialReference  Boolean?  @map("has_official_reference")
  filedByUserAt         DateTime? @map("filed_by_user_at")
  userNotes             String?   @map("user_notes") @db.Text
  recordedBy            String    @default("user") @map("recorded_by") @db.VarChar(64)
  userConfirmedFiled    Boolean?  @map("user_confirmed_filed")
  officialSubmissionUrl String?   @map("official_submission_url") @db.VarChar(512)
  officialTrackingUrl   String?   @map("official_tracking_url") @db.VarChar(512)
  officialFiledOn       DateTime? @map("official_filed_on") @db.Date
  createdAt             DateTime  @default(now()) @map("created_at")

  report Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@map("official_complaints")
}

model CaseUpdate {
  id               String   @id @default(uuid()) @db.Char(36)
  reportId         String?  @map("report_id") @db.Char(36)
  status           String?  @db.VarChar(64)
  message          String?  @db.Text
  recordedBy       String   @default("user") @map("recorded_by") @db.VarChar(64)
  statusSourceType String?  @map("status_source_type") @db.VarChar(32)
  createdAt        DateTime @default(now()) @map("created_at")

  report Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@map("case_updates")
}

model CommunityTip {
  id                     String    @id @default(uuid()) @db.Char(36)
  categorySlug           String    @map("category_slug") @db.VarChar(64)
  title                  String    @db.VarChar(120)
  body                   String    @db.Text
  whenToAct              String?   @map("when_to_act") @db.Text
  suggestedChannelLabel  String?   @map("suggested_channel_label") @db.VarChar(255)
  suggestedChannelUrl    String?   @map("suggested_channel_url") @db.VarChar(512)
  status                 String    @default("pending") @db.VarChar(32)
  agreeCount             Int       @default(0) @map("agree_count")
  disagreeCount          Int       @default(0) @map("disagree_count")
  contributorDeviceHash  String    @map("contributor_device_hash") @db.VarChar(128)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  reviewedAt             DateTime? @map("reviewed_at")
  reviewNote             String?   @map("review_note") @db.Text

  votes CommunityTipVote[]

  @@index([status, createdAt])
  @@index([categorySlug, status])
  @@map("community_tips")
}

model CommunityTipVote {
  id         String   @id @default(uuid()) @db.Char(36)
  tipId      String   @map("tip_id") @db.Char(36)
  deviceHash String   @map("device_hash") @db.VarChar(128)
  vote       String   @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at")

  tip CommunityTip @relation(fields: [tipId], references: [id], onDelete: Cascade)

  @@unique([tipId, deviceHash])
  @@index([tipId])
  @@map("community_tip_votes")
}

/// Public alerts posted anonymously by app users; visible to everyone.
model PublicAlert {
  id               String    @id @default(uuid()) @db.Char(36)
  type             String    @db.VarChar(32)
  placeName        String    @map("place_name") @db.VarChar(255)
  description      String    @db.Text
  photoPath        String?   @map("photo_path") @db.VarChar(255)
  latitude         Float
  longitude        Float
  areaLabel        String?   @map("area_label") @db.VarChar(120)
  authorDeviceHash String    @map("author_device_hash") @db.VarChar(128)
  seenCount        Int       @default(0) @map("seen_count")
  goneCount        Int       @default(0) @map("gone_count")
  flagCount        Int       @default(0) @map("flag_count")
  /// active | resolved | flagged | removed
  status           String    @default("active") @db.VarChar(16)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  votes PublicAlertVote[]
  flags PublicAlertFlag[]

  @@index([status, lastSeenAt])
  @@index([authorDeviceHash, createdAt])
  @@map("public_alerts")
}

model PublicAlertVote {
  id         String   @id @default(uuid()) @db.Char(36)
  alertId    String   @map("alert_id") @db.Char(36)
  deviceHash String   @map("device_hash") @db.VarChar(128)
  /// seen | gone
  vote       String   @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  alert PublicAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([alertId, deviceHash])
  @@index([alertId])
  @@map("public_alert_votes")
}

model PublicAlertFlag {
  id         String   @id @default(uuid()) @db.Char(36)
  alertId    String   @map("alert_id") @db.Char(36)
  deviceHash String   @map("device_hash") @db.VarChar(128)
  reason     String?  @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  alert PublicAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([alertId, deviceHash])
  @@index([alertId])
  @@map("public_alert_flags")
}
